# Server
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pricehub
DB_USER=pricehub
DB_PASSWORD=pricehub_dev
DB_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication
JWT_SECRET=change-me-to-a-random-256-bit-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google Cloud Storage (not needed for Step 1)
GCS_BUCKET_NAME=pricehub-uploads
GCS_PROJECT_ID=
GCS_KEY_FILE=

# BullMQ
BULL_QUEUE_PREFIX=pricehub

# Logging
LOG_LEVEL=debug

# CORS
CORS_ORIGIN=http://localhost:3000
