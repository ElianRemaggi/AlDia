# Production settings for docker-compose.prod.yml.
# Copy to .env.prod at the repo root (gitignored) and fill in. Never commit the real file.

# Public hostname. Its DNS A/AAAA record must point to this server; Caddy gets the TLS cert.
# For a plain-HTTP test box use DOMAIN=:80 and COOKIE_SECURE=false.
DOMAIN=pricehub.example.com
COOKIE_SECURE=true

# Host ports for the proxy (change only if 80/443 are taken by something else).
HTTP_PORT=80
HTTPS_PORT=443

# Secrets: generate with `openssl rand -hex 32`.
POSTGRES_PASSWORD=
JWT_SECRET=

LOG_LEVEL=info

# PDF fallback extraction with an LLM (OpenAI-compatible API; DeepSeek by default). Optional.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Google Cloud Storage for uploaded files. Leave empty to keep them on the `uploads` volume.
GCS_BUCKET_NAME=
GCS_PROJECT_ID=
GCS_KEY_FILE=
